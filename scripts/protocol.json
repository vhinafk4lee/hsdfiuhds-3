{
  "name": "hashbroker",
  "chainId": 4663,
  "contract": "0x4272d6f51771839f596082ef48fa84d35239bab3",
  "algorithm": "sha256",
  "preimage": [
    {"field": "wallet", "size": 20},
    {"field": "nonce", "size": 32},
    {"field": "challenge", "size": 32}
  ],
  "mine": "mine(uint256,bytes32)",
  "mineArgs": ["nonce", "challenge"],
  "views": {
    "challenge": "challenge()",
    "difficulty": "currentDifficulty()",
    "price": "mintPrice()",
    "minted": "totalSupply()",
    "maxSupply": "MAX_SUPPLY()",
    "lastMintBlock": "lastMintBlock()"
  },
  "validate": "isValidProof(address,uint256,bytes32)",
  "rpc": [
    "https://robinhood-rpc.publicnode.com",
    "https://robinhood.rpc.blxrbdn.com",
    "https://robinhood.drpc.org"
  ],
  "broadcastRpc": [],
  "verified": true
}
