# Copy to config.env and keep the real file out of git.
HASHBROKER_WALLET=0xYOUR_WALLET_ADDRESS
# Preferred: a 0600 file containing a 0x-prefixed 32-byte private key.
HASHBROKER_PRIVATE_KEY_FILE=./wallet.key
# Alternative for ephemeral hosts. Do not commit the value.
# HASHBROKER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Mint contract on Robinhood Chain. Overrides "contract" in scripts/protocol.json.
# HASHBROKER_CONTRACT=0x4272D6f51771839F596082eF48fa84D35239Bab3
# Hard ceiling on mint price + gas for a single mint, in wei.
HASHBROKER_SUBMIT_CAP_WEI=100000000000000000
HASHBROKER_RUNTIME_DIR=./runtime
HASHBROKER_RENTALS_FILE=./rentals.json
HASHBROKER_REMOTE_JOB_PATH=/opt/hashbroker/job.json

# Optional comma-separated overrides for the endpoints in scripts/protocol.json.
# HASHBROKER_RPC_URLS=https://rpc-one.example,https://rpc-two.example
# HASHBROKER_BROADCAST_RPC_URLS=https://sequencer.example
