# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Chat/channel id to post alerts to (add the bot as admin of the channel first).
# For a public channel you can use @your_channel_name, otherwise use the numeric id
# (e.g. -1001234567890 for a supergroup/channel).
TELEGRAM_CHAT_ID=

# GeckoTerminal network id (Robinhood Chain)
NETWORK=robinhood

# Alert when a pool's volume in a single 1-minute candle reaches this many USD
VOLUME_THRESHOLD_USD=300000

# How often to check for new 1-minute candles (seconds)
POLL_INTERVAL_SECONDS=60

# How many of the top pools (by 24h volume) to actively watch for 1-minute spikes.
# Public GeckoTerminal API is rate limited (~30 req/min), so this bounds API usage.
MAX_POOLS=25

# How often to refresh the list of "all tokens" (top active pools) being watched, in minutes
UNIVERSE_REFRESH_MINUTES=5

# Don't re-alert on the same pool more often than this, in minutes
ALERT_COOLDOWN_MINUTES=10
