# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Chat/channel to post alerts to. Add the bot to the channel as an admin first.
# Public channel: @your_channel_name — otherwise the numeric id (e.g. -1001234567890).
TELEGRAM_CHAT_ID=

# GeckoTerminal network id (Robinhood Chain)
NETWORK=robinhood

# Alert when a single time window trades at least this much volume, in USD
VOLUME_THRESHOLD_USD=200000

# Size of that window in minutes: 1, 5 or 15
WINDOW_MINUTES=1

# After a token is alerted, hold further alerts for it this many minutes. A pump
# crosses the threshold minute after minute; without this one move floods the
# channel. The hold is per token, so its other pools stay quiet too.
ALERT_COOLDOWN_MINUTES=30

# How often to scan the network, in seconds
POLL_INTERVAL_SECONDS=60

# Pools that must never trigger an alert, comma-separated. An entry matches a
# pair name, a base token symbol, or a token contract address:
#   BLACKLIST=USDG / WETH, USDC, 0xabc...
BLACKLIST=

# Tokenised stocks (NVDA, AMC, SPY...) trade heavily without being what these
# alerts are for, and there are hundreds of them, so the issuer's registry is
# pulled at startup and every 12h to exclude the whole category. 0 turns it off.
EXCLUDE_STOCK_TOKENS=1
STOCK_REGISTRY_URL=https://api.robinhood.com/rhj/assets

# Also check the network's trending pools each cycle (one extra request). These
# are ranked by recent activity rather than 24h volume, which is how a fresh
# token that is spiking right now gets seen at all. Set to 0 to turn off.
USE_TRENDING=1

# Investigate without posting: the scan runs and logs, Telegram gets nothing.
SILENT=0

# Post the "Bot started" notice on launch. Every redeploy restarts the process,
# so 0 keeps those out of the channel.
STARTUP_MESSAGE=1

# How deep to scan, at 20 pools per page. HOT_PAGES are scanned every cycle and
# ROTATING_PAGES of the rest take turns, which keeps a cycle within the few
# requests a minute the public API allows. Every page must be revisited within
# five minutes (the life of the 5m volume a spike is detected by) — the bot logs
# its coverage time at startup and warns if these settings break that.
MAX_POOL_PAGES=4
HOT_PAGES=1
ROTATING_PAGES=1
# Confirmations per cycle, one request each, highest 5m volume first. Anything
# over this waits for the next cycle — the 5m evidence lasts about five of them.
MAX_CANDIDATES_PER_CYCLE=2
