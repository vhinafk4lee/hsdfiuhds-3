# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Chat/channel to post alerts to. Add the bot to the channel as an admin first.
# Public channel: @your_channel_name — otherwise the numeric id (e.g. -1001234567890).
TELEGRAM_CHAT_ID=

# GeckoTerminal network id (Robinhood Chain)
NETWORK=robinhood

# Alert when a single time window trades at least this much volume, in USD
VOLUME_THRESHOLD_USD=300000

# Size of that window in minutes: 1, 5 or 15
WINDOW_MINUTES=1

# How often to scan the network, in seconds
POLL_INTERVAL_SECONDS=60

# Pools that must never trigger an alert, comma-separated. An entry matches a
# pair name, a base token symbol, or a token contract address:
#   BLACKLIST=USDG / WETH, USDC, 0xabc...
BLACKLIST=

# Also check the network's trending pools each cycle (one extra request). These
# are ranked by recent activity rather than 24h volume, which is how a fresh
# token that is spiking right now gets seen at all. Set to 0 to turn off.
USE_TRENDING=1

# How deep to scan, at 20 pools per page. HOT_PAGES are scanned every cycle and
# ROTATING_PAGES of the rest take turns, which keeps a cycle within the few
# requests a minute the public API allows. Every page must be revisited within
# five minutes (the life of the 5m volume a spike is detected by) — the bot logs
# its coverage time at startup and warns if these settings break that.
MAX_POOL_PAGES=8
HOT_PAGES=2
ROTATING_PAGES=2
MAX_CANDIDATES_PER_CYCLE=10
