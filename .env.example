# Telegram-бот: токен от @BotFather (нужен только для режима --bot)
BOT_TOKEN=123456789:AA...

# Сколько адресов проверять параллельно
CONCURRENCY=5
# Пауза (сек) после каждого запроса в каждом потоке
DELAY=0.3

# Прокси для запросов к API и Telegram (опционально)
HTTPS_PROXY=http://127.0.0.1:10809
